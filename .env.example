# MKA Environment Variables
# کپی کنید به .env و مقادیر واقعی را وارد کنید

# --- Telegram ---
TELEGRAM_BOT_TOKEN=          # از @BotFather برای @taxiran1395_bot
TELEGRAM_ADMIN_IDS=

# --- Backend API ---
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000
API_SECRET_KEY=change-me-to-a-long-random-string

# --- LLM / AI Gateway ---
# گزینه پیشنهادی: Ollama (رایگان و خصوصی)
LLM_PROVIDER=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:7b
OPENAI_API_KEY=ollama

# گزینه‌های جایگزین:
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash-lite
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# LLM_PROVIDER=openrouter
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemini-2.0-flash

# --- Vector Database (فاز بعد) ---
VECTOR_DB=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=mka_knowledge

# --- Google Drive (فاز بعد) ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_IDS=

# --- Admin ---
ADMIN_EMAIL=ziya.mka2026@gmail.com

LOG_LEVEL=INFO
