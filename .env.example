# MKA Environment Variables
# کپی کنید به .env و مقادیر واقعی را وارد کنید

# --- Telegram ---
TELEGRAM_BOT_TOKEN=          # از @BotFather برای @taxiran1395_bot
TELEGRAM_ADMIN_IDS=          # Chat ID ادمین‌ها

# --- Backend API ---
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000
API_SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=*

# --- LLM / AI Gateway ---
LLM_PROVIDER=gemini          # gemini | openai | openrouter | ollama
GOOGLE_API_KEY=              # کلید Gemini از AI Studio (فرمت AQ. یا AIza)
GEMINI_MODEL=gemini-2.0-flash-lite
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Vector Database (فاز بعد) ---
VECTOR_DB=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=mka_knowledge

# --- Google Drive (فاز بعد) ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_IDS=

# --- Admin ---
ADMIN_EMAIL=ziya.mka2026@gmail.com

# --- Observability ---
LOG_LEVEL=INFO
